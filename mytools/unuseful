        for a=1:size(associations_new,1) #for each association
            assoc = associations_new(a,:);
            if(assoc(3)< inlier_threshold)
                inliers+=1;
                inliers_idxs = [inliers_idxs, a];
                cost+= assoc(3);
            endif
        endfor
